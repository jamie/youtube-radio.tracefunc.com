{
  "name": "youtube-feed-worker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p scripts",
    "db:migrate:local": "wrangler d1 migrations apply radio-tracefunc-com --local",
    "db:migrate:remote": "wrangler d1 migrations apply radio-tracefunc-com --remote",
    "debug:playlist": "tsx scripts/debug-playlist.ts"
  },
  "dependencies": {
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.3.1",
    "@cloudflare/workers-types": "^5.20260928.1",
    "@types/node": "^26.6.3",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "vitest": "^4.1.0",
    "wrangler": "^4.143.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true,
    "workerd@1.20260926.1": true
  }
}
